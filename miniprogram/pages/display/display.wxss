.display-container {
  padding: 20rpx;
}

.image-grid {
  display: flex;
  justify-content: space-between;
}

.column {
  width: 48%;
}

.image-item {
  width: 100%;
  height: 300rpx;
  margin-bottom: 10rpx;
}

.image {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
  gap: 15rpx;
}

.page-info {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.nav-button {
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  color: white;
  background-color: #007AFF;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.3);
}

.nav-button:active {
  background-color: #005FCC;
}
