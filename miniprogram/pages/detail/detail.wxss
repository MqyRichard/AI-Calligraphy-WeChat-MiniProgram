.container {
  padding: 20rpx;
  background-color: #f8f8f8;
}

page {
  font-family: "STKaiti", "KaiTi", "KaiTi_GB2312", sans-serif;
}

/* 图片展示 */
.image-container {
  display: flex;
  width: 90%;
  justify-content: center;
  padding: 20rpx;
}

.display-image {
  width: 90%;
  max-height: 800rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.1);
}

/* 分割线 */
.divider {
  margin: 20rpx 0;
  height: 2rpx;
  background-color: #ddd;
}

/* 评分栏 */
.rating-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
}

.rating-label {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.star-box {
  padding: 10rpx;
}

.star {
  font-size: 40rpx;
  color: #bbb;
}

.star.selected {
  color: #ffcc00;
}

/* 评论输入框 */
.comment-box {
  display: flex;
  width: 85%;
  flex-direction: column;
  align-items: center;
  margin: 20rpx;
}

.comment-input {
  width: 90%;
  height: 150rpx;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  background-color: #fff;
  font-size: 28rpx;
}

.submit-button {
  margin-top: 20rpx;
  padding: 15rpx 40rpx;
  background-color: #007AFF;
  color: white;
  border-radius: 10rpx;
  font-size: 32rpx;
}

/* 评论区 */
.comments-section {
  padding: 20rpx;
  width: 80%;
}

.comment-item {
  display: flex;
  width: 95%;
  padding: 30rpx;
  align-items: flex-start;
  padding: 20rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.comment-content {
  flex: 1;
  padding: 10rpx 0;
}

.comment-header {
  display: flex;
  margin-bottom: 10rpx;
  justify-content: space-between;
  align-items: center;
  gap: 40rpx;
}

.username {
  font-weight: bold;
  font-size: 30rpx; /* 稍微增大字体，使其更清晰 */
  color: #222;
}

.rating {
  font-size: 28rpx;
  color: #ff9900;
}

.comment-text {
  margin-top: 15rpx; /* 增加上间距 */
  line-height: 1.6;
  color: #555;
}
