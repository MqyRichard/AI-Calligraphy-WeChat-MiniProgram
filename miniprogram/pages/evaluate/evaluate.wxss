.container {
  padding: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fafafa;
  min-height: 100vh;
  box-sizing: border-box;
}

.title {
  font-size: 22px;
  font-weight: bold;
  margin-bottom: 30px;
  color: #333;
}

.choose-button {
  background-color: #409EFF;
  color: white;
  padding: 14px 24px;
  border-radius: 25px;
  font-size: 16px;
  margin-bottom: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.preview-image {
  margin-top: 10px;
  max-width: 100%;
  border-radius: 12px;
  border: 1px solid #ddd;
}

.loading {
  margin-top: 20px;
  color: #888;
  font-size: 16px;
}

.result {
  margin-top: 24px;
  padding: 20px;
  background: #ffffff;
  border-radius: 12px;
  width: 100%;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.result-title {
  font-weight: bold;
  font-size: 18px;
  margin-bottom: 10px;
  color: #333;
}

.result-text {
  font-size: 15px;
  color: #555;
  white-space: pre-wrap;
  word-break: break-word;
}
