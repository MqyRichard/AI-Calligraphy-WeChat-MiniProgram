.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  height: 100vh;
  position: relative;
  overflow: hidden;
  padding-top: 0rpx;
}

.bg-image {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  font-family: "STKaiti", "KaiTi", serif;
  margin-top: 100rpx;
  margin-bottom: 100rpx;
  z-index: 1;
}

.banner {
  width: 80%;
  height: 600rpx;
  border-radius: 12rpx;
  margin-bottom: 70rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 1;
}

.nav-button-upload, .nav-button-selectauthor {
  margin-top: 40rpx;
  width: 60%;
  height: 80rpx;
  background-color: rgba(209, 156, 103, 0.8);
  color: white;
  font-size: 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
}
