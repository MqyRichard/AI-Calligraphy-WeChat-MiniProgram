.author-container {
  display: grid;
  grid-template-columns: 48% 48%;
  gap: 4%;
  padding: 20rpx;
}

.author-item {
  text-align: center;
  background-color: #f8f8f8;
  border-radius: 20rpx;
  padding: 10rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.author-img {
  width: 100%;
  height: 250rpx;
  border-radius: 10rpx;
}

.author-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-top: 10rpx;
}
