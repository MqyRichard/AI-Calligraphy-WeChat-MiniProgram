/* 全局样式 */
page {
  background-color: #f8f4e8;
  color: #5a4a3a;
  font-family: "PingFang SC", sans-serif;
  padding: 20rpx;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}
.subtitle {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 10rpx;
}

/* 通用区块样式 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin: 30rpx 0 20rpx;
  padding-left: 15rpx;
  border-left: 6rpx solid #d4a373;
}

/* 图片展示区域 */
.image-section, .upload-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.reference-image, .user-image {
  width: 100%;
  height: 400rpx;
  border-radius: 8rpx;
  border: 1rpx dashed #e0d5c8;
}

/* 上传按钮样式 */
.upload-button {
  background-color: #f9f5f0;
  border: 2rpx dashed #d4a373;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #d4a373;
  font-size: 28rpx;
  line-height: 1.6;
}
.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}
.reupload-button {
  margin-top: 20rpx;
  background-color: #f0e6d2;
  color: #5a4a3a;
}

/* 分析按钮 */
.analyze-button {
  background-color: #d4a373;
  color: white;
  margin: 40rpx 0;
  border-radius: 50rpx;
  font-size: 32rpx;
}
.button-hover {
  opacity: 0.9;
}

/* 结果区域 */
.result-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}
.result-content {
  max-height: 500rpx;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  padding: 15rpx;
}

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 999;
  color: white;
}
.loading-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}